# ==============================================================================
# KONFIGURASI APLIKASI
# ==============================================================================
APP_NAME="ERP Bengkel Alat Berat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ==============================================================================
# DATABASE EKSTERNAL TERKELOLA (PRODUKSI)
# ==============================================================================
# Pilih salah satu koneksi database eksternal terkelola di bawah ini.
# Masukkan nilai variabel ini di Dashboard Hosting (misal Vercel Environment Variables).
# JANGAN PERNAH menaruh kredensial asli di dalam repository Git.

# --- Opsi 1: PostgreSQL Terkelola (Rekomendasi: Neon.tech / Supabase / Aiven / AWS RDS) ---
DB_CONNECTION=pgsql
DB_HOST=your-database-host.neon.tech
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_password
DB_SSLMODE=require

# Alternatif URL tunggal untuk PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Opsi 2: MySQL Terkelola (PlanetScale / TiDB / Aiven / RDS) ---
# DB_CONNECTION=mysql
# DB_HOST=your-database-host.psdb.cloud
# DB_PORT=3306
# DB_DATABASE=erp_bengkel
# DB_USERNAME=your_username
# DB_PASSWORD=your_password
# MYSQL_ATTR_SSL_CA=

# --- Opsi 3: SQLite Lokal (Hanya untuk Pengembangan Offline / Dev Lokal) ---
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ==============================================================================
# SESSION, CACHE, DAN QUEUE (STATELESS & BEBAS DISK LOKAL)
# ==============================================================================
# Untuk hosting serverless (seperti Vercel), session harus berbasis cookie terenkripsi
# atau tabel database eksternal agar tidak hilang saat container berganti.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache store di serverless disarankan menggunakan array (in-memory per-request)
# atau database jika ingin berbagi cache antar instance.
CACHE_STORE=array

# Queue connection di serverless harus diset ke sync (dieksekusi langsung saat request)
# karena fungsi serverless tidak menjalankan daemon background worker.
QUEUE_CONNECTION=sync

# Filesystem lokal (/tmp untuk serverless) atau S3 untuk penyimpanan cloud
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bengkel.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# MODE DEMO PORTOFOLIO
# ==============================================================================
DEMO=true
